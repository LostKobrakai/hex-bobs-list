<section class="hero is-medium is-primary is-bold">
  <div class="hero-head">
    <.nav conn={@conn} />
  </div>

  <div class="hero-body">
    <div class="container has-text-centered">
      <h1 class="title">
        <%= @title %>
      </h1>
      <div class="subtitle">
        <%= @subtitle %>
      </div>
    </div>
  </div>

</section>

<main role="main" style="flex-grow: 1">
  <%= @inner_content %>
</main>

<footer class="footer">
  <div class="content has-text-centered">
    <p>
      <strong>Built</strong> by <a href="https://kobrakai.de">Benjamin Milde</a>.
    </p>
  </div>
</footer>
